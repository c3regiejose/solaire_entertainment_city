{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "drupal/asset_injector": "^2.21",
        "drupal/block_class": "^4.0",
        "drupal/block_field": "^1.0@RC",
        "drupal/content_insights_report": "^1.0",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recipe-unpack": "^11.4",
        "drupal/core-recommended": "^11",
        "drupal/devel": "^5.5",
        "drupal/ds": "^3.37",
        "drupal/entity_share": "^3.13",
        "drupal/entityqueue": "^1.12",
        "drupal/field_formatter_range": "^2.0",
        "drupal/field_group": "^4.0",
        "drupal/field_image_style": "^2.0",
        "drupal/gin": "^5.0",
        "drupal/google_analytics": "^4.0",
        "drupal/gtm": "^1.10",
        "drupal/imce": "^3.1",
        "drupal/mailsystem": "^4.5",
        "drupal/media_embed_extra": "^1.0@beta",
        "drupal/menu_item_extras": "^3.1",
        "drupal/menu_link_attributes": "^1.7",
        "drupal/metatag": "^2.2",
        "drupal/paragraphs": "^1.23",
        "drupal/paragraphs_list_filter": "^1.0",
        "drupal/pathauto": "^1.15",
        "drupal/phpmailer_smtp": "^2.4",
        "drupal/recaptcha": "^3.5",
        "drupal/s3fs": "^3.11",
        "drupal/search_api": "^1.41",
        "drupal/sitemap": "^2.6",
        "drupal/upgrade_status": "^4.3",
        "drupal/view_mode_selector": "^1.2",
        "drupal/webform": "^6.3",
        "drush/drush": "^13.7"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "enable-patching": true,
        "patches": {
            "drupal/entity_share": {
                "Issue #3587843: Fix entity_share_client": "patches/entity_share_client-3587843-2.patch"
            },
            "drupal/field_image_style": {
                "Issue #3593351: PHP 8.4: getSettableOptions()": "patches/field_image_style-php84-3593351.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    },
    "require-dev": {
        "kint-php/kint": "^6.1"
    }
}
